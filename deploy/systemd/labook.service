[Unit]
Description=Gunicorn instance for laBook Flask app
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pdlab
Group=pdlab
WorkingDirectory=/home/pdlab/labook
EnvironmentFile=-/etc/labook/metadata.env
Environment=LABOOK_OUTBOUND_ALLOWLIST=ndlsearch.ndl.go.jp,openapi.rakuten.co.jp,www.googleapis.com,thumbnail.image.rakuten.co.jp,books.google.com
ExecStart=/home/pdlab/labook/start_gunicorn.sh
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=labook
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000

[Install]
WantedBy=multi-user.target
